# ============================================================
# Variables de entorno para el backend PHP (Informix)
# Copia este archivo como: api/.env  (en el servidor PHP)
# ============================================================

# --- Conexión Informix vía ODBC ---
INFORMIX_ODBC_DRIVER=IBM INFORMIX ODBC DRIVER
INFORMIX_HOST=192.168.0.XXX
INFORMIX_PORT=9088
INFORMIX_DATABASE=afccajapatate
INFORMIX_SERVER=afcserver
INFORMIX_PROTOCOL=onsoctcp
INFORMIX_USER=informix
INFORMIX_PASSWORD=tu_password_informix

# --- Códigos de tipo de producto para clasificar cuentas ---
# Separa varios códigos con coma (ej: AV,AV1,AVP)
INFORMIX_TCDV_SAVINGS_CODES=
INFORMIX_TCDV_CERTIFICATE_CODES=

# --- Queries personalizables (dejar vacío = usar query predeterminado con bcausua) ---
# Solo completar si tu instancia Informix tiene estructura diferente a la estándar AFC
INFORMIX_LOGIN_QUERY=
INFORMIX_PROFILE_QUERY=
INFORMIX_ACCOUNTS_QUERY=
INFORMIX_REPORT_QUERY=
