# --- server.gutt_system.js: conexión INDEPENDIENTE a la base GUTT_SYSTEM ---
# NUNCA reutilizar SQL_SERVER_DATABASE (api/.env) aquí -- esa variable apunta a
# SQLGUTPATATE, la base de producción real de Caja Patate. Este archivo existe
# para que server.gutt_system.js jamás pueda conectarse a producción por accidente,
# ni siquiera si algún día se fusionan los .env.
#
# Host/instancia/usuario/password SÍ se reutilizan de api/.env (es la misma instancia
# física SQL Server local, CONY-DESARROLLO\SQLEXPRESS) -- solo el nombre de la base
# cambia, y por eso vive en su propia variable.
SQL_SERVER_DATABASE_GUTT=GUTT_SYSTEM

# Puerto propio, distinto del server.js real (5005), para poder correr ambos
# backends en paralelo sin pisarse durante la migración.
GUTT_API_PORT=5006

# CooperativaId que sirve ESTA instancia del proceso (ver comentario junto a
# COOPERATIVA_ID en server.gutt_system.js). 3 = Crediapoyo (RUC 1891813608001),
# el cliente real para el que se está preparando la venta. Cambiar a 1 para
# volver a Caja Patate (datos de prueba).
GUTT_COOPERATIVA_ID=3
